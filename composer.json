{
    "name": "strukt/generator",
    "description": "Typed class generation, lightweight templating, and PHPDoc annotations.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "strukt/base": "dev-main",
        "strukt/commons": "dev-main"
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "suggest": {
        "strukt/console": "Adds color() support for huecli() templates."
    },
    "autoload": {
        "psr-4": {
            "Strukt\\": "src/Strukt/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Payroll\\": "fixtures/app/src/Payroll/",
            "Contract\\": "fixtures/lib/Contract/",
            "Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../base",
            "options": {
                "symlink": false
            }
        },
        {
            "type": "path",
            "url": "../commons",
            "options": {
                "symlink": false
            }
        }
    ],
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "authors": [
        {
            "name": "pitsolu",
            "email": "pitsolu@gmail.com"
        }
    ]
}
